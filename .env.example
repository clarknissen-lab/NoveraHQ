# ─────────────────────────────────────────────────────────────────────
#  NOVERA STUDIO OS — Zugangsdaten
#
#  Diese Datei nach .env kopieren und die Werte eintragen.
#  .env ist über .gitignore ausgeschlossen und landet nie auf GitHub.
# ─────────────────────────────────────────────────────────────────────

# PFLICHT — Das Secret deiner Notion-Integration.
# notion.so/my-integrations → deine Integration → Internal Integration Secret
NOTION_TOKEN=ntn_hier_dein_secret

# PFLICHT — Die Notion-Seite, unter der gebaut wird.
# Du kannst die komplette Seiten-URL einfügen, der Builder holt sich die ID.
# Wichtig: Diese Seite muss über ••• → Connections mit der Integration
# verbunden sein, sonst sieht der Builder sie nicht.
NOTION_PARENT_PAGE=https://www.notion.so/Novera-24f1a0b3...


# ─────────────────────────────────────────────────────────────────────
#  Optional — alles hierunter darf leer bleiben.
#  Fehlt ein Wert, entsteht an der Stelle ein orange markierter Hinweis.
# ─────────────────────────────────────────────────────────────────────

# Header-Widget mit Logo und laufender Uhr (GitHub Pages).
# Daraus leitet der Builder auch Logo und Fokus-Timer ab.
NOVERA_CLOCK_URL=

# Deine Arbeitsplaylist.
NOVERA_SPOTIFY_URL=

# Google Calendar → Einstellungen → Kalender integrieren → URL aus dem iframe.
NOVERA_GCAL_EMBED_URL=

# Hauptordner in Google Drive.
NOVERA_DRIVE_URL=
